# Kopiraj ovu datoteku u ".env" (bez ".example") i upiši svoje podatke. Datoteka .env ne ide na Git.

# API ključ s resend.com (API Keys), izgleda kao re_xxxxxxxx
RESEND_API_KEY=

# Kamo stižu upiti. Dok koristiš probnog pošiljatelja (onboarding@resend.dev),
# to mora biti adresa kojom si se registrirao na Resendu.
UPIT_EMAIL_NA=

# Pošiljatelj. Za probu ostavi prazno. Za pravu stranicu: adresa s tvoje potvrđene domene,
# npr. Upiti sa stranice <upiti@tvoja-domena.hr>
UPIT_EMAIL_OD=
